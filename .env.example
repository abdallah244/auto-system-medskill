# WhatsApp Cloud API (Meta)
WHATSAPP_TOKEN=EAAG...
WHATSAPP_PHONE_NUMBER_ID=123456789012345
GRAPH_API_VERSION=v20.0

# Excel settings
EXCEL_FILE=./data/contacts.xlsx
SHEET_NAME=
PHONE_COLUMN=phone
NAME_COLUMN=name

# Message template (supports: {{name}}, {{phone}})
DEFAULT_MESSAGE=مرحبا {{name}}\nرسالتك هنا

# Sending controls
DRY_RUN=true
REQUEST_DELAY_MS=400
CONCURRENCY=1

# Server
PORT=3000
